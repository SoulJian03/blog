<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>ThinkPHP on SoulJian小站</title><link>https://souljian.cn/tags/thinkphp/</link><description>Recent content in ThinkPHP on SoulJian小站</description><generator>Hugo -- gohugo.io</generator><language>en-us</language><lastBuildDate>Sun, 30 Aug 2026 10:00:00 +0800</lastBuildDate><atom:link href="https://souljian.cn/tags/thinkphp/index.xml" rel="self" type="application/rss+xml"/><item><title>ThinkPHP5x-RCE漏洞复现</title><link>https://souljian.cn/p/751088179/</link><pubDate>Sat, 29 Aug 2026 14:00:00 +0800</pubDate><guid>https://souljian.cn/p/751088179/</guid><description>&lt;h2 id="写在前面合法学习边界"&gt;写在前面：合法学习边界
